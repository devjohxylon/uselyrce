# Discord
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
GUILD_ID=your_discord_server_id

# Error monitoring (https://sentry.io) — leave empty to disable.
# Production start uses: node --import ./src/observability/sentry.js src/index.js
# In Sentry: enable email/Slack alerts on new issues for production.
SENTRY_DSN=
# Optional: 0–1 sample rate for performance traces (default 0.05)
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Platform paging (Discord webhook and/or email). Falls back to SUPPORT_FORWARD_TO for email.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_EMAIL=

# Kill switches / capacity (redeploy after change, except incident file via /api/ops/incident)
# MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=
# DISABLE_KITS=false
# DISABLE_WIPE_SCHEDULER=false
# DISABLE_SLASH_COMMANDS=false
# MAX_RCON_CONNECTIONS=40
# STATUS_INCIDENT_MESSAGE=
# ALLOW_STRIPE_TEST=false

# ——— SaaS multi-tenant (opt-in) ———
# Leave SAAS_MODE=false for single-server legacy mode.
SAAS_MODE=false
# Local testing without Supabase/Stripe/OAuth: SAAS_MOCK=true fakes the whole
# SaaS backend (mock login, orgs, servers, billing) using .data/mock-saas.json
SAAS_MOCK=false
# Production: Usely project https://iteyedqonfhwrrqtwrxm.supabase.co (not the Aces shared DB)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte key, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RCON_ENCRYPTION_KEY=
# Discord OAuth for panel login (add redirect URL in Discord portal)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Production must use sk_live_… (sk_test_ is refused unless ALLOW_STRIPE_TEST=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match pricing page: Basic $20 / Pro $49 / Network $99
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_NETWORK=
# Root domain for per-org panels (myserver.usely.dev). Needs a wildcard DNS
# record (*.usely.dev) pointing at this app. Local default: localhost, so org
# panels live at <slug>.localhost:3847.
SAAS_BASE_DOMAIN=
# Resend API key for purchase/setup emails. Empty = emails logged to
# .data/mock-outbox.json instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Usely <onboarding@usely.dev>
# Public support address (shown on the site / mailto).
SUPPORT_EMAIL=support@inbound.usely.dev
# Your real inbox — contact form + inbound Resend forwards land here.
SUPPORT_FORWARD_TO=you@gmail.com
# From Resend → Webhooks → signing secret (email.received).
RESEND_WEBHOOK_SECRET=
# Shared access code for the platform ops console at /ops
# (customer workspace list — not the game admin panel). Leave empty to disable.
USELY_OPS_CODE=
# HMAC secret for /ops cookies (do not reuse USELY_OPS_CODE). Falls back to ADMIN_SESSION_SECRET.
USELY_OPS_SESSION_SECRET=
# When true, /ops shows sample workspaces (no Supabase). Turn off for live data.
USELY_OPS_MOCK=false
# Vercel Web Analytics → /ops traffic (www.usely.dev). Create a token at
# vercel.com/account/tokens. Project ID from Project Settings → General.
# Enable Analytics on the marketing project in the Vercel dashboard first.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Required if the project is under a team (starts with team_).
VERCEL_TEAM_ID=

# ——— Webhook / admin panel ———
BOT_WEBHOOK_SECRET=your_webhook_secret
BOT_WEBHOOK_PORT=3847
ADMIN_PANEL_PASSWORD=change-me
# Required when SAAS_MODE=true — dedicated HMAC secret for panel session cookies
ADMIN_SESSION_SECRET=
# Public admin URL. Local: http://localhost:3847  Prod: https://app.usely.dev
ADMIN_PANEL_URL=http://localhost:3847
BRAND_URL=https://usely.dev
# Optional logo override for Discord panels. Leave empty to use the bundled logo.
BRAND_LOGO_URL=
# Where links/kits/stats are stored. On Railway mount a volume here (default /app/.data).
DATA_DIR=

# ——— Discord post channels ———
CHANNEL_LEADERBOARD=
CHANNEL_ANNOUNCEMENTS=
CHANNEL_WIPES=
CHANNEL_EVENTS=

# ——— Community / mod channels ———
CHANNEL_MOD_LOG=
# Ticket open/close + transcripts (falls back to CHANNEL_MOD_LOG if empty)
CHANNEL_TICKET_LOG=
CHANNEL_WELCOME=
CHANNEL_STAFF_ALERT=
CATEGORY_TICKETS=

# ——— Roles ———
ROLE_STAFF_IDS=123456789,987654321
ROLE_VERIFIED=
ROLE_VIP=
ROLE_AUTO_MEMBER=

# ——— Giveaways ———
GIVEAWAY_MIN_ACCOUNT_DAYS=1
GIVEAWAY_MIN_JOIN_HOURS=1
# ——— Auto-mod ———
AUTOMOD_ENABLED=true
MIN_ACCOUNT_DAYS=0
MIN_JOIN_HOURS=0
LINK_ALLOWLIST=usely.dev,tip4serv.com
ALLOW_DISCORD_INVITES=false
WORD_FILTER=
RAID_JOIN_THRESHOLD=8
RAID_WINDOW_SECONDS=15
AUTO_MUTE_AFTER_WARNS=3
AUTO_MUTE_MINUTES=60

# ——— Rust server (RCON) ———
# Nitrado → server settings → WebRCON
# HOST = IP only (no port). PORT = RCON port only (e.g. 25800).
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=
RCON_SERVER_NAME=main
RCON_CHAT_BRIDGE=false
RCON_INGAME_KILLFEED=false
RCON_LEADERBOARD_PUSH_MS=600000
RCON_STATUS_UPDATE_MS=120000

# ——— Rust Map (for Live Map feature) ———
# Get from Nitrado → Settings → World Seed and World Size
RUST_MAP_SEED=
RUST_MAP_SIZE=4000
# Best for Console: upload a map screenshot in the admin Live Map tab
# (saved to .data/maps). Or set a direct image URL:
RUST_MAP_IMAGE_URL=
# PC only — Console maps do NOT match. Off unless you set RUSTMAPS_ENABLE=true
RUSTMAPS_API_KEY=
RUSTMAPS_ENABLE=false

# ——— In-game feed channels ———
# Prefer setting these in the admin panel → Server Commands tab.
# Panel values override .env and are stored in .data/settings.json
CHANNEL_KILLFEED=
CHANNEL_JOIN_LEAVE=
CHANNEL_GAME_CHAT=
CHANNEL_GAME_EVENTS=
CHANNEL_ADMIN_LOG=
CHANNEL_POP_STATUS=
CHANNEL_WIPE_STATUS=
CHANNEL_TP_LOG=
CHANNEL_REPORTS=

# ——— Group limit (trio = 3) ———
GROUP_MAX_MEMBERS=3

# ——— Teleports ———
TP_ENABLED=true
TP_MAX_HOMES=2
TP_VIP_MAX_HOMES=5
TP_COOLDOWN_SECONDS=300
TP_VIP_COOLDOWN_SECONDS=60
TP_DELAY_SECONDS=10
TP_TPR_ENABLED=true

# ——— VIP sync (Discord ROLE_VIP → in-game kit) ———
# Create a kit with this id in the admin Kits tab
VIP_KIT_ID=vip
# Optional override instead of kit: VIP_RCON_GRANT=inventory.giveto "{ign}" "scrap" 500
VIP_RCON_GRANT=
VIP_RCON_REVOKE=

# ——— Wipe countdown (ISO fallback; panel Overview can override) ———
WIPE_AT=

# ——— Economy ———
ECONOMY_ENABLED=true
ECONOMY_KILL_REWARD=25
ECONOMY_DEATH_PENALTY=5
ECONOMY_PLAYTIME_REWARD=10
ECONOMY_PLAYTIME_MINUTES=30
ECONOMY_STARTING_BALANCE=100

# ——— Server pop ———
SERVER_MAX=100
POP_POLL_MS=30000

ADMIN_USER_IDS=
